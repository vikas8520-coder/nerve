# Vercel ignore patterns - exclude heavy directories from deployment
node_modules/**
app_backup/**
.git/**
*.md
docs/**
tests/**
skills/**
bin/**
migrations/**
images/**
electron/**
@nerve/opencode-provider/**
@nerve/opencode-plugin/**
dist/**
.build/**
*.log
*.tsbuildinfo
CHANGELOG*
LICENSE*
README*
CONTRIBUTING*
SECURITY*
# Keep scripts/build/ for postinstall, exclude other scripts subdirs
scripts/**
!scripts/build/