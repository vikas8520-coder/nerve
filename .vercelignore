# Vercel ignore patterns - exclude heavy directories from deployment
node_modules/**
app_backup/**
.git/**
*.md
docs/**
tests/**
skills/**
bin/**
migrations/**
images/**
electron/**
@nerve/opencode-provider/**
@nerve/opencode-plugin/**
dist/**
.build/**
*.log
*.tsbuildinfo
CHANGELOG*
LICENSE*
README*
CONTRIBUTING*
SECURITY*
# Exclude scripts/ subdirs except build/
scripts/*
!scripts/build/
!scripts/build/**